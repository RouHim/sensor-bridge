{
  "name": "sensor-bridge-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend tooling for Sensor Bridge",
  "type": "module",
  "scripts": {
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "format": "prettier --write src/js/**/*.js src/*.html src/*.css",
    "format:check": "prettier --check src/js/**/*.js src/*.html src/*.css",
    "check:syntax": "node --check src/js/main.js && echo 'All JS files syntax check passed'",
    "check:all": "npm run lint && npm run format:check && npm run check:syntax"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}